# Set this in Vercel: Project -> Settings -> Environment Variables.
# It is read only by api/rpc.js on the server and is never sent to a browser.
ARC_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional. Extra origins allowed to call /api/rpc, comma separated.
# Same-origin and localhost are always allowed; leave unset unless you need more.
# ALLOWED_ORIGINS=https://yourdomain.com
